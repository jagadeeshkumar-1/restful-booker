  "security": [
    {
      "testName": "createWithXssInFirstname_storedAsPlainText",
      "body": {
        "firstname": "<script>alert('xss')</script>",
        "lastname": "Safe",
        "totalprice": 100,
        "depositpaid": true,
        "bookingdates": { "checkin": "2025-01-01", "checkout": "2025-01-05" },
        "additionalneeds": "None"
      },
      "expectedStatus": 200,
      "description": "Script injection in firstname"
    },
    {
      "testName": "createWithSqlInjectionInLastname_doesNotCrash",
      "body": {
        "firstname": "SQL",
        "lastname": "'; DROP TABLE bookings; --",
        "totalprice": 100,
        "depositpaid": false,
        "bookingdates": { "checkin": "2025-01-01", "checkout": "2025-01-05" },
        "additionalneeds": "None"
      },
      "expectedStatus": 200,
      "description": "SQL injection in lastname"
    },
    {
      "testName": "createWithJsonInjectionInNotes_doesNotBreakResponse",
      "body": {
        "firstname": "Json",
        "lastname": "Inject",
        "totalprice": 100,
        "depositpaid": true,
        "bookingdates": { "checkin": "2025-01-01", "checkout": "2025-01-05" },
        "additionalneeds": "\"},\"admin\":true,\"x\":\""
      },
      "expectedStatus": 200,
      "description": "JSON injection in additionalneeds"
    },
    {
      "testName": "createWithNullByteInFirstname_doesNotCrash",
      "body": {
        "firstname": "First\u0000Name",
        "lastname": "Last",
        "totalprice": 100,
        "depositpaid": true,
        "bookingdates": { "checkin": "2025-01-01", "checkout": "2025-01-05" },
        "additionalneeds": "None"
      },
      "expectedStatus": 200,
      "description": "Null byte injection in firstname"
    }
  ],
